PORT=3003
NODE_ENV=development

JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_48_caracteres

# Chaine de connexion PostgreSQL, lue par Prisma.
DATABASE_URL=postgresql://registrations_user:remplacer@localhost:5432/registrations

# URLs des services amont, pour verifier l'evenement et le participant avant inscription.
EVENTS_SERVICE_URL=http://event-service:3001
PARTICIPANTS_SERVICE_URL=http://participants-service:3002
HTTP_TIMEOUT_MS=3000
