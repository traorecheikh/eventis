{
  "name": "participants-service",
  "version": "1.0.0",
  "description": "Microservice de gestion des participants pour EventHub",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dx": "node scripts/dx.js",
    "lint:esm": "node scripts/check-no-require.js",
    "pretest": "npm run lint:esm",
