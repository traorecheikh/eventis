# Copier ce fichier en .env et adapter les valeurs si besoin.
#
# Les variables prefixees par VITE_ sont exposees au code frontend via
# import.meta.env.VITE_*. Elles sont lues a la construction (npm run build ou
# docker build) : les modifier apres coup n'a aucun effet.

# URL de l'API backend, vue depuis le navigateur. En production (derriere la
# passerelle Nginx, voir gateway/nginx.conf) et en developpement local avec
# `npm run dev` (proxy Vite vers http://localhost:80, voir vite.config.js),
# /api suffit dans les deux cas.
VITE_API_BASE_URL=/api
