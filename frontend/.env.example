# ============================================================
# EventHub - Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs :
#   cp .env.example .env
#
# Les variables préfixées par VITE_ sont exposées au code
# frontend via import.meta.env.VITE_*. Elles sont lues à la
# construction (npm run build ou docker build) : les modifier
# après le build n'a aucun effet.

# URL de l'API backend EventHub.
# - En développement local : URL complète du backend (mock-api ou
#   microservice réel), par exemple http://localhost:8080/api
# - En production derrière Nginx/Docker : utiliser simplement /api,
#   car le serveur de production relaie /api/* vers le backend
#   défini par BACKEND_URL (aucun nom de conteneur en dur).
VITE_API_BASE_URL=http://localhost:8080/api

# Version de l'API
VITE_API_VERSION=v1

# -------------------------------------------------------------
# Variables Docker / production (uniquement en exécution)
# -------------------------------------------------------------
# BACKEND_URL : URL du backend vers laquelle Nginx relaie les
# appels /api/*. À régler au lancement du conteneur (-e).
# Exemples :
#   http://backend-service:8080          (réseau Docker)
#   http://host.docker.internal:8080     (backend sur l'hôte)
BACKEND_URL=http://localhost:8080
