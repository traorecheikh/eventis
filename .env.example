# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer le .env. Il figure dans .gitignore.
#
# Génération d'un mot de passe : openssl rand -base64 24
# Génération du secret JWT    : openssl rand -base64 48

# ---------------------------------------------------------------
# Secret partagé par les 4 services pour signer et vérifier les JWT
# ---------------------------------------------------------------
JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_48_caracteres
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------
# Bases de données, une par service
# ---------------------------------------------------------------
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=remplacer
AUTH_DB_NAME=auth

EVENTS_DB_USER=events_user
EVENTS_DB_PASSWORD=remplacer
EVENTS_DB_NAME=events

PARTICIPANTS_DB_USER=participants_user
PARTICIPANTS_DB_PASSWORD=remplacer
PARTICIPANTS_DB_NAME=participants

REGISTRATIONS_DB_USER=registrations_user
REGISTRATIONS_DB_PASSWORD=remplacer
REGISTRATIONS_DB_NAME=registrations

# ---------------------------------------------------------------
# URL internes, noms de services Docker, ne pas modifier en local
# ---------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:3004
EVENTS_SERVICE_URL=http://events-service:3001
PARTICIPANTS_SERVICE_URL=http://participants-service:3002
REGISTRATIONS_SERVICE_URL=http://registrations-service:3003

# ---------------------------------------------------------------
# Divers
# ---------------------------------------------------------------
NODE_ENV=development
HTTP_TIMEOUT_MS=3000

# Frontend, URL de l'API vue depuis le navigateur
VITE_API_BASE_URL=/api
