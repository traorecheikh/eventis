# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer le .env. Il figure dans .gitignore.
#
# Génération d'un mot de passe : openssl rand -base64 24
# Génération du secret JWT    : openssl rand -base64 48

PORT=3004
NODE_ENV=development

JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_48_caracteres

# Chaine de connexion PostgreSQL, lue par Prisma.
DATABASE_URL=postgresql://auth_user:remplacer@localhost:5432/auth
