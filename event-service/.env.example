PORT=3001
NODE_ENV=development

JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_48_caracteres

# Chaine de connexion PostgreSQL, lue par Prisma.
DATABASE_URL=postgresql://events_user:remplacer@localhost:5432/events

# URL du service inscriptions, pour calculer la disponibilite (GET /events/:id/availability).
REGISTRATIONS_SERVICE_URL=http://registrations-service:3003
HTTP_TIMEOUT_MS=3000
